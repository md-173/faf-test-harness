<configuration>

    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <!--
      Custom pattern word %component — resolves MDC, then LoggerContext, then "Unknown".
      Both the MDC key and the LoggerContext property are set by LoggingSetup.configure(),
      so async threads that don't inherit the thread-local MDC still tag correctly.
    -->
    <conversionRule conversionWord="component"
                    converterClass="com.faforever.testharness.shared.logging.ComponentConverter" />

    <!--
      Log level: set LOG_LEVEL env var (DEBUG, INFO, WARN, ERROR).
      Default: INFO.
    -->
    <property name="LOG_LEVEL" value="${LOG_LEVEL:-INFO}" />

    <!--
      Log file: set LOG_FILE env var to customise the JSONL output path.
      Default: logs/<component>.jsonl
    -->
    <property name="LOG_FILE" value="${LOG_FILE:-logs/test-harness.jsonl}" />

    <!-- Human-readable console output for developers. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!--
              Format: [2026-04-17 12:00:00] [MockClient] [INFO ] Connected.
              %component is defined by ComponentConverter (see <conversionRule> above) and
              falls back to the LoggerContext property when the thread-local MDC is empty,
              so log lines emitted from async workers stay tagged with the right component.
            -->
            <pattern>[%d{yyyy-MM-dd HH:mm:ss.SSS}] [%component] [%-5level] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Machine-parseable JSONL file output for the automated test suite. -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>5</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder class="com.faforever.testharness.shared.logging.JsonLineEncoder" />
    </appender>


    <root level="${LOG_LEVEL}">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

</configuration>

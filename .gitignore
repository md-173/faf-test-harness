# Operations (local planning doc; case-robust so Backlog.csv / backlog.csv both match)
/documentation/operations/[Bb]acklog.csv

# Provisioned faf-ice-adapter binary (fetch via ./gradlew downloadIceAdapter)
/faf-ice-adapter.jar

# Provisioned faf-uid binary (download per documentation/demos/README.md; also .exe / -macos)
/faf-uid*
# Windows/WSL NTFS alternate-data-stream artifacts
*Zone.Identifier

# Sprint demo screenshots (local evidence for standups, not repo content)
/sprint-pack/

# Local environment overrides. The harness reads none of these (config comes from
# defaults -> --config JSON -> FAF_MOCK_CLIENT_* env -> CLI flags); ignored so a
# stray .env.local holding a token can never be committed.
.env
.env.*

# Internal project-management and academic documents, removed at 7.1 (see
# documentation/operations/public-release-record.md §1). They remain in git history by
# deliberate decision -- the removal is for a clean tree, not secrecy -- so any of them
# can be restored locally with `git show <old-commit>:<path> > <path>`. Ignored so a
# restored copy can never be re-committed.
/documentation/project-spec.md
/documentation/task-desc.md
/documentation/meetings/
/documentation/needs-answering/
/documentation/operations/cost.md
/documentation/operations/schedule.md
/documentation/operations/team-roles.md

### Mac OS ###
.DS_Store

# Editorconfig
.editorconfig
/faf-test-harness/.idea
/.idea
/mock-client/logs
/mock-game/logs
/shared/logs
/logs/

# Operations (local planning doc; case-robust so Backlog.csv / backlog.csv both match)
/documentation/operations/[Bb]acklog.csv

# Provisioned faf-ice-adapter binary (fetch via ./gradlew downloadIceAdapter)
/faf-ice-adapter.jar

# Release jars downloaded to the repo root by the README's own no-clone instructions, and the
# directory logback creates in the working directory when LOG_DIR is unset — which the ICE adapter
# reads, so running it from a clone leaves one behind. Anyone following the README lands here, so
# this is not just tidying after ourselves (WBS-7.6, #317).
/mock-client-*-all.jar
/mock-game-*-all.jar
/LOG_DIR_IS_UNDEFINED/

# Provisioned faf-uid binary (download per documentation/demos/README.md; also .exe / -macos)
/faf-uid*
# Windows/WSL NTFS alternate-data-stream artifacts
*Zone.Identifier

# Sprint demo screenshots (local evidence for standups, not repo content)
/sprint-pack/

# Local environment overrides. The harness reads none of these (config comes from
# defaults -> --config JSON -> FAF_MOCK_CLIENT_* env -> CLI flags); ignored so a
# stray .env.local holding a token can never be committed.
.env
.env.*
